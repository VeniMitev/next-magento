{
  "name": "next-magento-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:infra && npm run dev:apps",
    "dev:infra": "docker-compose up -d",
    "dev:apps": "concurrently \"npm run -w apps/bff-api start:dev\" \"npm run -w apps/storefront-next dev\" --names \"bff,next\" --prefix-colors \"blue,magenta\"",
    "build": "npm run build --workspaces --if-present",
    "build:bff": "npm run -w apps/bff-api build",
    "build:next": "npm run -w apps/storefront-next build",
    "start:bff": "npm run -w apps/bff-api start:prod",
    "start:next": "npm run -w apps/storefront-next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "magento:setup": "bash scripts/magento-setup.sh",
    "magento:seed": "bash scripts/magento-seed.sh",
    "infra:stop": "docker-compose down",
    "infra:clean": "docker-compose down -v"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.4",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "typescript": "^5.3.3"
  }
}
